generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  PROVIDER
  ADMIN
}

enum EntityType {
  INDIVIDUAL
  COMPANY
  GOVERNMENT
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  IN_PROGRESS
  COMPLETED
}

enum BudgetType {
  FIXED
  HOURLY
  MILESTONE
}

enum ProjectVisibility {
  PUBLIC
  PRIVATE
  INVITE_ONLY
}

enum BidStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ReportSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ReportStatus {
  SUBMITTED
  UNDER_REVIEW
  NEED_MORE_INFO
  VALID
  REJECTED
}

enum PaymentCurrency {
  INR
  USD
}

enum PaymentStatus {
  PENDING
  IN_ESCROW
  RELEASED
  REFUNDED
}

enum PspProviderName {
  RAZORPAY
  STRIPE
  MANUAL
}

enum PspCheckoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum KycStatus {
  NOT_STARTED
  PENDING
  APPROVED
  REJECTED
}

enum BugBountyProgramStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum BugReportStatus {
  SUBMITTED
  VALID
  REJECTED
  DUPLICATE
}

enum NotificationType {
  NEW_BID
  BID_ACCEPTED
  REPORT_SUBMITTED
  REPORT_VALIDATED
  PAYMENT_RELEASED
  BUG_BOUNTY_REPORT_SUBMITTED
}

enum LedgerEntryType {
  DEPOSIT
  ESCROW_HOLD
  ESCROW_RELEASE
  REFUND
  WITHDRAWAL
  PLATFORM_FEE
  MILESTONE_FUND
  MILESTONE_RELEASE
  MILESTONE_REJECT_REFUND
  HOURLY_BILL
}

enum TimeEntryStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  BILLED
}

enum HourlyEngagementStatus {
  ACTIVE
  PAUSED
  CLOSED
}

enum LedgerEntryStatus {
  PENDING
  POSTED
  FAILED
  REVERSED
}

enum MilestoneStatus {
  PENDING
  FUNDED
  IN_PROGRESS
  SUBMITTED
  APPROVED
  RELEASED
  DISPUTED
}

enum WithdrawalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum DisputeCategory {
  PAYMENT
  MILESTONE
  REPORT_QUALITY
  NON_DELIVERY
  FRAUD
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REFUNDED
  REJECTED
}

enum OrganizationMemberRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
}

enum EnterpriseSsoProtocol {
  OIDC
  SAML
}

enum FileUploadStatus {
  PENDING_UPLOAD
  ACTIVE
  FAILED
}

enum VirusScanStatus {
  PENDING
  CLEAN
  INFECTED
  SKIPPED
  ERROR
}

enum AiJobType {
  SCOPE_REVIEW
  PROPOSAL_ENHANCE
  REPORT_ANALYSIS
  RISK_CLASSIFICATION
  DUPLICATE_DETECTION
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      UserRole @default(CLIENT)

  firstName  String?
  lastName   String?
  country    String?
  city       String?
  state      String?
  postalCode String?

  entityId  String?
  entity    Entity?  @relation(fields: [entityId], references: [id], onDelete: SetNull)

  providerProfile ProviderProfile?
  clientProfile   ClientProfile?

  projects Project[] @relation("UserProjects")
  bids     Bid[]     @relation("ProviderBids")
  selectedProjects Project[] @relation("SelectedProviderProjects")
  messages Message[]
  reports  Report[]
  triagedReports Report[] @relation("ReportValidatedBy")
  reviewsGiven   Review[] @relation("ReviewClient")
  reviewsReceived Review[] @relation("ReviewProvider")
  clientReviewsGiven   ClientReview[] @relation("ClientReviewProvider")
  clientReviewsReceived ClientReview[] @relation("ClientReviewClient")
  timeEntries            TimeEntry[]
  timeEntriesApproved    TimeEntry[] @relation("TimeEntryApprover")
  userSettings           UserSettings?
  paymentsMade     Payment[] @relation("PaymentPayer")
  paymentsReceived Payment[] @relation("PaymentPayee")

  bugBountyPrograms   BugBountyProgram[]
  bugReportsSubmitted BugReport[]       @relation("BugReportResearcher")
  notifications       Notification[]
  fileAssets          FileAsset[]
  vdpPrograms         VdpProgram[]

  wallet                    UserWallet?
  walletLedgerEntries       WalletLedgerEntry[] @relation("UserLedgerLines")
  withdrawalRequests        WithdrawalRequest[]
  reviewedWithdrawals       WithdrawalRequest[] @relation("WithdrawalReviewer")
  milestoneComments         MilestoneComment[]
  savedSearches             SavedSearch[]
  disputesOpened            Dispute[]           @relation("DisputeOpenedBy")
  disputeComments           DisputeComment[]
  organizationMembers     OrganizationMember[]
  aiUsageLogs               AiUsageLog[]
  moderationAuditLogs       ModerationAuditLog[] @relation("ModerationActor")
  fraudFlag                 FraudFlag?
  pspCheckoutSessions       PspCheckoutSession[] @relation("PspCheckoutPayer")
  kycSubmissions            KycSubmission[]
  kycReviews                KycSubmission[]      @relation("KycReviewer")
  userSessions              UserSession[]
  paymentAuditLogs          PaymentAuditLog[]    @relation("PaymentAuditActor")
  emailTemplatesEdited      EmailTemplate[]      @relation("EmailTemplateEditor")
  apiKeys                   ApiKey[]
  webhookEndpoints          WebhookEndpoint[]

  emailVerifiedAt              DateTime?
  emailVerificationTokenHash   String?
  emailVerificationExpiresAt   DateTime?
  emailVerificationOtpHash     String?
  emailVerificationLastSentAt DateTime?
  passwordResetTokenHash       String?
  passwordResetExpiresAt       DateTime?

  createdAt DateTime @default(now())

  @@index([emailVerificationTokenHash])
  @@index([passwordResetTokenHash])
}

model Entity {
  id                 String             @id @default(cuid())
  type               EntityType
  name               String
  verificationStatus VerificationStatus @default(UNVERIFIED)

  users User[]

  createdAt DateTime @default(now())
}

model ProviderProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  skills          String[] @default([])
  certifications  String[] @default([])
  rating          Float    @default(0)
  totalReviews    Int      @default(0)
  completedProjects Int    @default(0)
  validReportCount Int     @default(0)
  reputationScore Float    @default(0)
  bidCredits      Int      @default(5)
  bio             String   @default("")
  portfolio       Json?
  availabilityStatus String @default("AVAILABLE")

  createdAt       DateTime @default(now())

  providerSkills ProviderSkill[]
}

model ClientProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  companySize String?
  rating        Float @default(0)
  totalReviews  Int   @default(0)

  createdAt   DateTime @default(now())
}

model Project {
  id          String        @id @default(cuid())
  title       String
  description String
  assets      Json
  inScope     String[]      @default([])
  outOfScope  String[]      @default([])
  testingWindow String
  budgetType  BudgetType
  budgetAmount Float
  timeline    String
  visibility  ProjectVisibility @default(PUBLIC)

  clientId    String
  client      User          @relation("UserProjects", fields: [clientId], references: [id], onDelete: Restrict)
  bids        Bid[]
  selectedProviderId String?
  selectedProvider User? @relation("SelectedProviderProjects", fields: [selectedProviderId], references: [id], onDelete: SetNull)
  messages Message[]
  reports  Report[]
  review   Review?
  clientReview ClientReview?
  hourlyEngagement HourlyEngagement?
  payment  Payment?
  files    FileAsset[]
  milestones ProjectMilestone[]
  disputes   Dispute[]
  projectSkills ProjectSkill[]
  organizationLink OrganizationProject?
  pspCheckoutSessions PspCheckoutSession[]

  status      ProjectStatus @default(DRAFT)

  createdAt   DateTime      @default(now())

  @@index([clientId])
  @@index([selectedProviderId])
  @@index([status])
}

model Bid {
  id         String    @id @default(cuid())
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  providerId String
  provider   User      @relation("ProviderBids", fields: [providerId], references: [id], onDelete: Cascade)
  proposal   String
  price      Float
  timeline   String
  status     BidStatus @default(PENDING)
  createdAt  DateTime  @default(now())

  @@index([projectId])
  @@index([providerId])
  @@index([status])
}

model Message {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  message   String
  createdAt DateTime @default(now())
  files     FileAsset[]

  @@index([projectId])
  @@index([senderId])
}

model Report {
  id          String         @id @default(cuid())
  projectId   String
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  submittedBy String
  submitter   User           @relation(fields: [submittedBy], references: [id], onDelete: Cascade)
  title       String
  description String
  severity    ReportSeverity
  status      ReportStatus   @default(SUBMITTED)
  triageNotes String?
  aiTriageHints Json?
  validatedBy String?
  validator   User?          @relation("ReportValidatedBy", fields: [validatedBy], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())
  files       FileAsset[]

  @@index([projectId])
  @@index([submittedBy])
  @@index([severity])
  @@index([status])
  @@index([validatedBy])
}

model Payment {
  id        String          @id @default(cuid())
  projectId String          @unique
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  payerId   String
  payer     User            @relation("PaymentPayer", fields: [payerId], references: [id], onDelete: Restrict)
  payeeId   String
  payee     User            @relation("PaymentPayee", fields: [payeeId], references: [id], onDelete: Restrict)
  amount    Float
  currency  PaymentCurrency @default(INR)
  status    PaymentStatus   @default(PENDING)
  createdAt DateTime        @default(now())

  pspCheckoutSession PspCheckoutSession?

  @@index([payerId])
  @@index([payeeId])
  @@index([status])
}

model Review {
  id         String   @id @default(cuid())
  projectId  String   @unique
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientId   String
  client     User     @relation("ReviewClient", fields: [clientId], references: [id], onDelete: Restrict)
  providerId String
  provider   User     @relation("ReviewProvider", fields: [providerId], references: [id], onDelete: Restrict)
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  @@index([clientId])
  @@index([providerId])
}

model ClientReview {
  id         String   @id @default(cuid())
  projectId  String   @unique
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  providerId String
  provider   User     @relation("ClientReviewProvider", fields: [providerId], references: [id], onDelete: Restrict)
  clientId   String
  client     User     @relation("ClientReviewClient", fields: [clientId], references: [id], onDelete: Restrict)
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  @@index([clientId])
  @@index([providerId])
}

model HourlyEngagement {
  id             String                 @id @default(cuid())
  projectId      String                 @unique
  project        Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  hourlyRate     Decimal                @db.Decimal(18, 4)
  currency       PaymentCurrency        @default(INR)
  weeklyCapHours Float                  @default(40)
  status         HourlyEngagementStatus @default(ACTIVE)
  timeEntries    TimeEntry[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
}

model TimeEntry {
  id             String          @id @default(cuid())
  engagementId   String
  engagement     HourlyEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  providerId     String
  provider       User            @relation(fields: [providerId], references: [id], onDelete: Cascade)
  workDate       DateTime        @db.Date
  hours          Decimal         @db.Decimal(8, 2)
  description    String
  status         TimeEntryStatus @default(DRAFT)
  submittedAt    DateTime?
  approvedAt     DateTime?
  approvedById   String?
  approvedBy     User?           @relation("TimeEntryApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  rejectedReason String?
  billedAt       DateTime?
  billedAmount   Decimal?        @db.Decimal(18, 4)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([engagementId])
  @@index([providerId])
  @@index([engagementId, status])
}

model UserSettings {
  userId            String    @id
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailDigestWeekly Boolean   @default(true)
  lastEmailDigestAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model BugBountyProgram {
  id                   String                 @id @default(cuid())
  clientId             String
  client               User                   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title                String
  description          String                 @default("")
  scope                Json
  rewardTable          Json
  status               BugBountyProgramStatus @default(DRAFT)
  allowedResearcherIds String[]               @default([])
  createdAt            DateTime               @default(now())
  bugReports           BugReport[]

  @@index([clientId])
  @@index([status])
}

model BugReport {
  id           String          @id @default(cuid())
  programId    String
  program      BugBountyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  researcherId String
  researcher   User            @relation("BugReportResearcher", fields: [researcherId], references: [id], onDelete: Cascade)
  title        String
  description  String
  severity     ReportSeverity
  status       BugReportStatus @default(SUBMITTED)
  createdAt    DateTime        @default(now())
  files        FileAsset[]

  @@index([programId])
  @@index([researcherId])
  @@index([status])
}

model VdpProgram {
  id        String          @id @default(cuid())
  clientId  String
  client    User            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title     String
  scope     Json
  policy    String
  createdAt DateTime        @default(now())
  submissions VdpSubmission[]

  @@index([clientId])
}

model VdpSubmission {
  id           String           @id @default(cuid())
  vdpId        String
  vdp          VdpProgram       @relation(fields: [vdpId], references: [id], onDelete: Cascade)
  title        String
  description  String
  contactEmail String?
  severity     ReportSeverity?
  createdAt    DateTime         @default(now())
  files        FileAsset[]

  @@index([vdpId])
}

model FileAsset {
  id           String   @id @default(cuid())
  storageKey   String
  originalName String
  mimeType     String
  size         Int
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  projectId    String?
  project      Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  workspaceReportId String?
  workspaceReport   Report? @relation(fields: [workspaceReportId], references: [id], onDelete: SetNull)

  bugReportId String?
  bugReport   BugReport? @relation(fields: [bugReportId], references: [id], onDelete: SetNull)

  messageId String?
  message   Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  vdpSubmissionId String?
  vdpSubmission   VdpSubmission? @relation(fields: [vdpSubmissionId], references: [id], onDelete: SetNull)

  disputeEvidence DisputeEvidence?

  storageProvider  String?
  retentionPolicy  String?
  virusScanStatus  VirusScanStatus @default(PENDING)
  uploadStatus     FileUploadStatus @default(ACTIVE)

  createdAt DateTime @default(now())

  @@index([uploadedById])
  @@index([projectId])
  @@index([workspaceReportId])
  @@index([bugReportId])
  @@index([messageId])
  @@index([vdpSubmissionId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  message   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([userId, read])
}

model LoginCode {
  id         String   @id @default(cuid())
  email      String
  codeHash   String
  attempts   Int      @default(0)
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([email])
  @@index([email, expiresAt])
  @@index([email, consumedAt])
}

// --- Financial infrastructure (ledger-backed) ---

model PlatformWallet {
  id                 String   @id @default(cuid())
  availableBalance   Decimal  @default(0) @db.Decimal(18, 4)
  pendingBalance     Decimal  @default(0) @db.Decimal(18, 4)
  escrowBalance      Decimal  @default(0) @db.Decimal(18, 4)
  lifetimeEarnings   Decimal  @default(0) @db.Decimal(18, 4)
  totalSpent         Decimal  @default(0) @db.Decimal(18, 4)
  currency           PaymentCurrency @default(INR)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  ledgerEntries WalletLedgerEntry[]
}

model UserWallet {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  availableBalance   Decimal  @default(0) @db.Decimal(18, 4)
  pendingBalance     Decimal  @default(0) @db.Decimal(18, 4)
  escrowBalance      Decimal  @default(0) @db.Decimal(18, 4)
  lifetimeEarnings   Decimal  @default(0) @db.Decimal(18, 4)
  totalSpent         Decimal  @default(0) @db.Decimal(18, 4)
  currency           PaymentCurrency @default(INR)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  ledgerEntries WalletLedgerEntry[]
}

model WalletLedgerEntry {
  id               String            @id @default(cuid())
  type             LedgerEntryType
  amount           Decimal           @db.Decimal(18, 4)
  currency         PaymentCurrency   @default(INR)
  status           LedgerEntryStatus @default(POSTED)
  /// External reference: projectId, milestoneId, withdrawalId, paymentId, etc.
  referenceId      String
  metadata         Json?
  createdAt        DateTime          @default(now())

  userWalletId     String?
  userWallet       UserWallet?       @relation(fields: [userWalletId], references: [id], onDelete: SetNull)
  platformWalletId String?
  platformWallet   PlatformWallet?   @relation(fields: [platformWalletId], references: [id], onDelete: SetNull)

  /// Optional link to the acting user (payer, admin) for audit
  actorUserId      String?
  actorUser        User?             @relation("UserLedgerLines", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([referenceId])
  @@index([type, createdAt])
  @@index([userWalletId])
  @@index([platformWalletId])
  @@index([actorUserId])
}

model PlatformFeeConfig {
  id               String   @id @default(cuid())
  clientFeeBps     Int      @default(0)
  providerFeeBps   Int      @default(0)
  effectiveFrom    DateTime @default(now())
  effectiveTo      DateTime?
  createdAt        DateTime @default(now())

  @@index([effectiveFrom])
}

model WithdrawalRequest {
  id             String                  @id @default(cuid())
  userId         String
  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount         Decimal                 @db.Decimal(18, 4)
  currency       PaymentCurrency         @default(INR)
  status         WithdrawalRequestStatus @default(PENDING)
  adminReviewerId String?
  adminReviewer   User?                  @relation("WithdrawalReviewer", fields: [adminReviewerId], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?
  metadata       Json?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([userId])
  @@index([status])
}

model ProjectMilestone {
  id              String          @id @default(cuid())
  projectId       String
  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title           String
  description     String          @default("")
  sortOrder       Int             @default(0)
  amount          Decimal         @db.Decimal(18, 4)
  currency        PaymentCurrency @default(INR)
  status          MilestoneStatus @default(PENDING)
  partialPercent  Int?
  releasedAmount  Decimal?        @db.Decimal(18, 4)
  fundedAt        DateTime?
  submittedAt     DateTime?
  approvedAt      DateTime?
  releasedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  comments MilestoneComment[]

  @@index([projectId])
  @@index([projectId, status])
}

model MilestoneComment {
  id          String           @id @default(cuid())
  milestoneId String
  milestone   ProjectMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  authorId    String
  author      User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body        String
  createdAt   DateTime         @default(now())

  @@index([milestoneId])
  @@index([authorId])
}

// --- Phase 3: Disputes ---

model Dispute {
  id          String          @id @default(cuid())
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  openedById  String
  openedBy    User            @relation("DisputeOpenedBy", fields: [openedById], references: [id], onDelete: Cascade)
  category    DisputeCategory
  status      DisputeStatus   @default(OPEN)
  title       String
  description String          @default("")
  resolution  String?
  resolvedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  evidence DisputeEvidence[]
  comments DisputeComment[]

  @@index([projectId])
  @@index([status])
  @@index([openedById])
}

model DisputeEvidence {
  id         String   @id @default(cuid())
  disputeId  String
  dispute    Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  fileAssetId String  @unique
  fileAsset  FileAsset @relation(fields: [fileAssetId], references: [id], onDelete: Cascade)
  note       String?
  createdAt  DateTime @default(now())

  @@index([disputeId])
}

model DisputeComment {
  id        String   @id @default(cuid())
  disputeId String
  dispute   Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  internal  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([disputeId])
}

// --- Phase 4: Search ---

model Skill {
  id        String   @id @default(cuid())
  slug      String   @unique
  label     String
  createdAt DateTime @default(now())

  providerLinks ProviderSkill[]
  projectLinks  ProjectSkill[]
}

model ProviderSkill {
  providerProfileId String
  providerProfile   ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)
  skillId           String
  skill             Skill           @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([providerProfileId, skillId])
  @@index([skillId])
}

model ProjectSkill {
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skillId   String
  skill     Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([projectId, skillId])
  @@index([skillId])
}

model SavedSearch {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  queryJson Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// --- Phase 7: AI usage ---

model AiUsageLog {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobType   AiJobType
  tokensIn  Int       @default(0)
  tokensOut Int       @default(0)
  metadata  Json?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([jobType])
}

// --- Phase 8: Trust / moderation ---

model ModerationAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation("ModerationActor", fields: [actorId], references: [id], onDelete: Cascade)
  action     String
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorId])
}

model FraudFlag {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score     Int      @default(0)
  reasons   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- Phase 11: Organizations ---

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members OrganizationMember[]
  projects OrganizationProject[]
  ssoConfig OrganizationSsoConfig?
}

model OrganizationSsoConfig {
  id                   String                @id @default(cuid())
  organizationId       String                @unique
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  protocol             EnterpriseSsoProtocol @default(OIDC)
  enabled              Boolean               @default(false)
  issuerUrl            String
  clientId             String
  clientSecret         String
  allowedEmailDomains  String[]              @default([])
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
}

model OrganizationMember {
  id             String                 @id @default(cuid())
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           OrganizationMemberRole @default(MEMBER)
  createdAt      DateTime               @default(now())

  @@unique([organizationId, userId])
  @@index([userId])
}

model OrganizationProject {
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String       @unique
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([organizationId, projectId])
}

// --- Phase 1 launch: PSP, KYC, sessions, audit ---

model PspCheckoutSession {
  id                String            @id @default(cuid())
  projectId         String
  project           Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  payerId           String
  payer             User              @relation("PspCheckoutPayer", fields: [payerId], references: [id], onDelete: Cascade)
  amount            Float
  currency          PaymentCurrency   @default(INR)
  provider          PspProviderName
  status            PspCheckoutStatus @default(PENDING)
  providerOrderId   String?
  providerPaymentId String?
  idempotencyKey    String            @unique
  metadata          Json?
  failureReason     String?
  paidAt            DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  paymentId         String?           @unique
  payment           Payment?          @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  auditLogs         PaymentAuditLog[]

  @@index([projectId])
  @@index([payerId])
  @@index([status])
  @@index([providerOrderId])
  @@index([providerPaymentId])
}

model PaymentAuditLog {
  id              String             @id @default(cuid())
  sessionId       String?
  session         PspCheckoutSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  eventType       String
  provider        PspProviderName?
  providerEventId String?            @unique
  actorUserId     String?
  actorUser       User?              @relation("PaymentAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  payload         Json?
  createdAt       DateTime           @default(now())

  @@index([sessionId])
  @@index([eventType])
}

model KycSubmission {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status             KycStatus @default(PENDING)
  panNumberMasked    String?
  panHolderName      String?
  bankAccountLast4   String?
  bankIfsc           String?
  bankAccountHolder  String?
  adminNotes         String?
  reviewedById       String?
  reviewedBy         User?     @relation("KycReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([userId])
  @@index([status])
}

model UserSession {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model EmailTemplate {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  category    String   @default("general")
  description String   @default("")
  subject     String
  title       String
  preheader   String?
  innerHtml   String   @db.Text
  textBody    String   @db.Text
  variables   String[] @default([])
  updatedById String?
  updatedBy   User?    @relation("EmailTemplateEditor", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

// --- Phase 3: Integrations (public API keys + outbound webhooks) ---

enum WebhookEventType {
  REPORT_VALIDATED
  MILESTONE_RELEASED
  PAYMENT_RELEASED
  BID_ACCEPTED
  PROJECT_COMPLETED
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String
  keyPrefix  String
  keyHash    String    @unique
  scopes     String[]  @default(["read"])
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model WebhookEndpoint {
  id         String             @id @default(cuid())
  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String
  url        String
  secret     String
  events     WebhookEventType[]
  enabled    Boolean            @default(true)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  deliveries WebhookDelivery[]

  @@index([userId])
}

model WebhookDelivery {
  id           String            @id @default(cuid())
  endpointId   String
  endpoint     WebhookEndpoint   @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  event        WebhookEventType
  payload      Json
  statusCode   Int?
  success      Boolean           @default(false)
  errorMessage String?
  createdAt    DateTime          @default(now())

  @@index([endpointId])
  @@index([createdAt])
}

// --- Platform Settings (admin-configurable) ---

enum MailProvider {
  AUTO
  SMTP
  SENDGRID
  AWS_SES
  POSTMARK
  NONE
}

enum SessionPolicy {
  MULTI_DEVICE
  SINGLE_DEVICE
}

model PlatformSettings {
  id        String   @id @default("singleton")
  // --- Mail configuration ---
  mailProvider         MailProvider @default(AUTO)
  mailFromAddress      String      @default("")
  mailFromName         String      @default("HD Team")
  mailReplyTo          String      @default("")
  smtpHost             String      @default("smtp.gmail.com")
  smtpPort             Int         @default(587)
  smtpUser             String      @default("")
  smtpPassword         String      @default("")  // encrypted at rest in production
  sendgridApiKey       String      @default("")
  awsSesAccessKeyId    String      @default("")
  awsSesSecretKey      String      @default("")  // encrypted at rest in production
  awsSesRegion         String      @default("us-east-1")
  postmarkServerToken  String      @default("")  // encrypted at rest in production
  primaryMailProvider   MailProvider @default(SMTP) // default provider for AUTO fallback order
  // --- Token expiry ---
  accessTokenExpiryMinutes  Int    @default(15)
  refreshTokenExpiryDays    Int    @default(7)
  // --- Email code validity ---
  emailVerificationCodeValue Int   @default(24)   // numeric value
  emailVerificationCodeUnit  String @default("HOURS") // MINUTES | HOURS | DAYS
  loginOtpCodeValue          Int   @default(10)   // numeric value
  loginOtpCodeUnit           String @default("MINUTES") // MINUTES | HOURS | DAYS
  // --- Session / multi-device policy ---
  sessionPolicy        SessionPolicy @default(MULTI_DEVICE)
  maxConcurrentSessions Int          @default(0)  // 0 = unlimited

  updatedAt DateTime @updatedAt
}
