# Server
NODE_ENV=development
PORT=4000
# Comma-separated origins for CORS (browser apps)
WEB_ORIGIN=http://localhost:3000

# PostgreSQL (matches docker-compose defaults)
DATABASE_URL=postgresql://hackersdeal:hackersdeal@localhost:5432/hackersdeal?schema=public

# Redis (placeholder — wire ioredis/bull later)
REDIS_URL=redis://localhost:6379

# JWT (placeholder — use strong secrets in production)
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# OAuth callback URLs must be publicly reachable
PUBLIC_API_URL=http://localhost:4000

OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_CALLBACK_URL=http://localhost:4000/auth/oauth/google/callback

OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_MICROSOFT_CALLBACK_URL=http://localhost:4000/auth/oauth/microsoft/callback

OAUTH_FACEBOOK_APP_ID=
OAUTH_FACEBOOK_APP_SECRET=
OAUTH_FACEBOOK_CALLBACK_URL=http://localhost:4000/auth/oauth/facebook/callback

OAUTH_LINKEDIN_CLIENT_ID=
OAUTH_LINKEDIN_CLIENT_SECRET=
OAUTH_LINKEDIN_CALLBACK_URL=http://localhost:4000/auth/oauth/linkedin/callback

LOGIN_CODE_TTL_MINUTES=10
