# Server
NODE_ENV=development
PORT=4000
# Comma-separated origins for CORS (browser apps)
WEB_ORIGIN=http://localhost:3000,https://hackersdeal.vercel.app

# PostgreSQL (matches docker-compose defaults)
# Local Postgres
# DATABASE_URL=postgresql://hackersdeal:hackersdeal@localhost:5432/hackersdeal?schema=public

# Azure Postgres (fill password manually)
DATABASE_URL=postgresql://hdadmin:ghp_om2iDkKqf5qN@hd-database.postgres.database.azure.com:5432/postgres?schema=public&sslmode=require
# Redis (placeholder — wire ioredis/bull later)
REDIS_URL=redis://localhost:6379

# JWT (placeholder — use strong secrets in production)
JWT_ACCESS_SECRET=cb0fbb2e2a034b97b5fc7f7b1f4c6b9e
JWT_REFRESH_SECRET=0d1e98e23fdf49a7a9231c8a9115e6f4
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# SendGrid (optional: enable email for notification events)
SENDGRID_ENABLED=false
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=HackersDeal

# OAuth (set these in production; callback URLs must be publicly reachable)
# WEB_ORIGIN is used to redirect back to the web app via /auth/callback
PUBLIC_API_URL=http://localhost:4000

OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_CALLBACK_URL=http://localhost:4000/auth/oauth/google/callback

OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_MICROSOFT_CALLBACK_URL=http://localhost:4000/auth/oauth/microsoft/callback

OAUTH_FACEBOOK_APP_ID=
OAUTH_FACEBOOK_APP_SECRET=
OAUTH_FACEBOOK_CALLBACK_URL=http://localhost:4000/auth/oauth/facebook/callback

OAUTH_LINKEDIN_CLIENT_ID=
OAUTH_LINKEDIN_CLIENT_SECRET=
OAUTH_LINKEDIN_CALLBACK_URL=http://localhost:4000/auth/oauth/linkedin/callback

LOGIN_CODE_TTL_MINUTES=10

# Mail (dynamic): Gmail SMTP preferred when GMAIL_SMTP_* is set; else SendGrid if SENDGRID_API_KEY is set.
MAIL_PROVIDER=auto
MAIL_FROM_ADDRESS=hdteam@hackersdeal.com
MAIL_REPLY_TO=hdteam@hackersdeal.com
MAIL_FROM_NAME=HD Team

# Gmail SMTP (use an App Password: Google Account → Security → App passwords)
GMAIL_SMTP_USER=proasisbusiness@gmail.com
GMAIL_SMTP_APP_PASSWORD=jify jprg jtvq abjb
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
